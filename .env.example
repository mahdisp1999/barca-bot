# Copy to .env (next to main.py) and fill in. Real environment variables win over this file.

TELEGRAM_BOT_TOKEN=123456:ABC-your-token
TELEGRAM_ADMIN_ID=111111111            # receives reminders/results; the only /usage user
ALLOWED_USERS=222222222,333333333      # comma separated. Empty (and no admin) = everybody is allowed
SPORTS_API_KEY=your-sportsapipro-key

# Optional
# TEAM_ID=2817                         # FC Barcelona. Verify with a real API response
# LOCAL_TZ=Asia/Tehran
# REMINDER_MINUTES=5,10,15,30,60
# BOT_API_BASE_URL=https://your-proxy.example.workers.dev/bot
# DB_PATH=barca_data.db                # relative paths are relative to the project root
# CACHE_FILE=barca_cache.json
# LOG_RETENTION_DAYS=180